# ==============================================================================
# Mymensingh City Citizen Service Platform (আমার ময়মনসিংহ / My Mymensingh)
# Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment & Debugging
APP_NAME="আমার ময়মনসিংহ"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_KEY=base64:amar_mayor_development_secure_key_32bytes_min

# Database Connection (MySQL 8+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amarmayor
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Redis Connection (Cache, Sessions, Rate Limits, Locks)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DATABASE=0
REDIS_PREFIX=amarmayor:

# Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE_NAME=amarmayor_session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Logging Configuration
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_FILE_PATH=storage/logs/app.log

# Communication Drivers & Provider Placeholders (Development Mocks)
SMS_DRIVER=mock
EMAIL_DRIVER=mock
PUSH_DRIVER=mock
MAPS_DRIVER=osm

# Rate Limiting Parameters (Requests per minute)
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_OTP=3
